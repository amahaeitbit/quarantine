# Copy to .env and fill in. Never commit .env.

MONGODB_URI=            # sandbox cluster connection string (never a local or other cluster)
DB_NAME=quarantine
REPLAY_DB_NAME=quarantine_replay      # same sandbox cluster, different database

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=
LLM_WORKSPACE_ID=       # wrkspc_... ; only needed when the key is not scoped to a workspace
LLM_EFFORT=             # blank for claude-haiku-4-5; low | medium | high on 5.x models
LLM_TEMPERATURE=0       # sent to the API; 5.x Claude models reject anything but 1, leave blank there

GATEWAY_URL=http://localhost:8000/mcp
USE_VECTOR_SEARCH=0     # 1 once the vector index exists
EVOLVER_ENABLED=1
RAINDROP_ENABLED=0      # 1 for demo runs; 0 while iterating (free plan: 1,000 events/month)
RAINDROP_WRITE_KEY=
MEMORY_BACKEND=ledger   # or agent_engine (milestone 7)
AGENT_ENGINE_MEMORY_URL=
